{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "version": "2.1.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "author": "Btw.kek",
  "homepage_url": "https://github.com/Btwkek/tablo-newtab",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "search"
  ],
  "optional_permissions": [
    "bookmarks"
  ],
  "content_security_policy": "script-src 'self'; object-src 'self'",
  "browser_specific_settings": {
    "gecko": {
      "id": "tablo-newtab@btwkek",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "locationInfo"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
